GROQ_API_KEY=gsk_your_groq_api_key_here

# ── STT Language ───────────────────────────────────────────────────────────────
# "en" for English, "hi" for Hindi, "auto" for auto-detect
STT_LANGUAGE=en
TTS_LANG=en
SURVEY_LANGUAGE=en

# ── DO NOT SET WHISPER_MODEL HERE ─────────────────────────────────────────────
# Large models (large-v3-turbo) will OOM on CPU (10+ min load / system hang).
# Model is controlled exclusively via server/config.py  BEST_ASR_MODEL = "tiny"
# Uncomment only if you have a dedicated GPU and know what you are doing:
# WHISPER_MODEL=large-v3-turbo

# ── Cache ──────────────────────────────────────────────────────────────────────
CACHE_THRESHOLD=0.75

TTS_TLD=co.in

# ── Twilio ─────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+your_twilio_phone_number

# ── ngrok ──────────────────────────────────────────────────────────────────────
NGROK_AUTH_TOKEN=your_ngrok_auth_token
# Optional: set a static domain from ngrok.com/domains to avoid changing URLs:
NGROK_STATIC_DOMAIN=your-static-domain.ngrok-free.dev

# Auto-updated by start_with_tunnel.py on every run — do not edit manually:
PUBLIC_URL=https://your-ngrok-url.ngrok-free.dev
